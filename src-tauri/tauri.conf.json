{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiom Logic",
  "version": "0.1.0",
  "identifier": "com.axiomlogic.latex",
  "build": {
    "frontendDist": "../Frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Axiom Logic",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/formula_worker.py",
      "resources/requirements.txt",
      "resources/models/pix2tex/model"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
