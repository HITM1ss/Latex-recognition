{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiom Logic",
  "version": "0.1.0",
  "identifier": "com.axiomlogic.latex",
  "build": {
    "frontendDist": "../Frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Axiom Logic",
        "width": 1000,
        "height": 905,
        "minWidth": 700,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/formula_worker.py",
      "resources/requirements.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "artifactName": "AxiomLogic-${version}-setup.exe"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/HITM1ss/Latex-recognition/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxODM1QUU5RTIzMUJCODUKUldTRnV6SGk2VnFENGNOQVhyOXF1ZEppemRRNVlUMGZjWjJHRmd0UTJRNmxLekdsdW41L0h3c1IK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
